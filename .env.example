NODE_ENV=development
PORT=4000

# Clients must send it in the x-api-key header (min 16 chars). Generate: openssl rand -hex 24
API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=90000

# Days a researched model plan is reused before searching the web again
PLAN_CACHE_DAYS=180

# Optional: defaults to data/mecanibot.db and logs/
DB_PATH=
LOG_DIR=

# Browser origins allowed by CORS (comma separated). The mobile app does not need it.
CORS_ORIGINS=
